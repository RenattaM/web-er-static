RewriteEngine On

# staré stránky z předchozí verze webu
RewriteRule ^sluzby\.html$ / [R=301,L]
RewriteRule ^gdpr\.html$ /zasady-ochrany-osobnich-udaju [R=301,L]

# .html adresa přesměruje na čistou (jen u přímého požadavku zvenčí)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# čistá adresa interně obslouží .html soubor
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
